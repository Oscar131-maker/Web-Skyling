# Copia este archivo como .env y rellena los valores reales.
# Nunca subas .env a Git.

# Base de datos PostgreSQL (obligatorio en Railway)
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

# Clave secreta para sesiones
SESSION_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria

# Credenciales de acceso a la app
USER_USERNAME=tu_usuario
USER_PASSWORD=tu_contraseña_segura

# API Key de OpenRouter (usada para generar textos)
ANTHROPIC_OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx

# Entorno (development | production)
NODE_ENV=development

# Puerto local (opcional, por defecto 3000)
PORT=3000
